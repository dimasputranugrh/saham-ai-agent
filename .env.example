# ==========================================================
# KONFIGURASI TIM KARYAWAN AI SAHAM (TELEGRAM + GEMINI AI)
# ==========================================================

# 1. Google Gemini API Key (Dapatkan gratis di: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=masukkan_api_key_gemini_anda_disini
GEMINI_MODEL=gemini-3.6-flash

# 2. Telegram Bot Token (Buat di Telegram lewat @BotFather -> ketik /newbot)
TELEGRAM_BOT_TOKEN=masukkan_token_bot_telegram_anda_disini

# 3. Telegram Chat ID Anda (Agar karyawan AI tahu harus lapor DSU & sinyal ke siapa)
# Cara cek: Chat ke @userinfobot di Telegram atau jalankan bot lalu ketik /start
# Wajib diisi. Jika kosong, semua perintah ditolak (fail-closed).
TELEGRAM_CHAT_ID=masukkan_chat_id_telegram_anda_disini
# Biarkan false di produksi agar chat pertama tidak otomatis menjadi owner.
ALLOW_AUTO_REGISTER_OWNER=false

# 4. Keamanan HTTP API (opsional, sangat disarankan jika dashboard publik)
API_AUTH_TOKEN=
# Demo beli dari chart hanya aktif jika true.
ENABLE_DEMO_TRADING=false
# URL publik untuk tombol WebApp Telegram.
PUBLIC_BASE_URL=https://saham-ai-agent.onrender.com

# 5. Daftar Saham Pantauan Default (Bisa diubah kapan saja lewat chat Telegram /watchlist)
# Gunakan akhiran .JK untuk saham Indonesia (BEI), atau tanpa akhiran untuk saham US (misal AAPL, NVDA)
DEFAULT_WATCHLIST=BBCA.JK,BBRI.JK,BMRI.JK,TLKM.JK,ASII.JK,BREN.JK,AMMN.JK,GOTO.JK,ANTM.JK,ADRO.JK,MDKA.JK,PGAS.JK

# 6. Jadwal Kerja Karyawan AI (Zona Waktu WIB / Asia/Jakarta)
DSU_MORNING_TIME=08:15
MARKET_CLOSE_TIME=16:15
# Ambang batas skor kuantitatif minimal (0-100) untuk kirim alert otomatis "Beli Jam Segini"
MIN_INTRADAY_ALERT_SCORE=68

# 7. Konfigurasi Eksekusi Otomatis Stockbit (isi PIN Trading 6 angka Anda sendiri)
STOCKBIT_TRADING_PIN=masukkan_6_angka_pin_stockbit_disini
STOCKBIT_MAX_LOT=2
# Verifikasi DOM setelah submit. Jika indikator sukses tidak ketemu, order dianggap gagal.
STOCKBIT_VERIFY_ORDER=true
# Wajibkan tombol Konfirmasi sebelum order live dikirim.
STOCKBIT_REQUIRE_CONFIRMATION=true

# 8. Mode Eksekusi & Keamanan Broker
# PAPER = simulasi (default), BACKTEST = riset, LIVE = order sungguhan.
EXECUTION_MODE=PAPER
# Harus true (dan EXECUTION_MODE=LIVE) agar order Stockbit benar-benar dikirim.
ALLOW_LIVE_BROKER_EXECUTION=false
# Modal awal virtual untuk validasi arus kas ledger. 0 = validasi kas dimatikan.
PAPER_INITIAL_CASH=0

# 9. Kalender Libur Bursa (opsional)
# Isi file data/idx_holidays.json dengan daftar "YYYY-MM-DD". Tanpa file ini hanya Sabtu/Minggu yang dilewati.
# IDX_HOLIDAYS_FILE otomatis memakai data/idx_holidays.json
